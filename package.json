{
  "name": "minimal-expo-app-template",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @deessejs/mobile start",
    "android": "pnpm --filter @deessejs/mobile android",
    "build:android:local": "pnpm --filter @deessejs/mobile build:android:local",
    "ios": "pnpm --filter @deessejs/mobile ios",
    "lint": "oxlint apps/mobile",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:expo": "pnpm --filter @deessejs/mobile exec expo-doctor",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:expo"
  },
  "devDependencies": {
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.13.0 <27",
    "pnpm": ">=10 <13"
  },
  "packageManager": "pnpm@12.16.1"
}
